---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Page not found"><section class="page-intro"><p class="eyebrow">404 / PAGE NOT FOUND</p><h1>A loose end<br />in <em>the lab.</em></h1><p class="lead">This address doesn’t lead to a page. Head back to the project shelf or start from Home.</p><div class="actions"><a class="button" href={base}>Go home →</a><a class="text-link" href={`${base}projects/`}>Explore Projects →</a></div></section></Layout>
